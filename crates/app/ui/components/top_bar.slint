import { ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component TopBar inherits Rectangle {
    in property <string> repo-name: "git-oxide";
    in property <string> repo-path: "";
    in property <[string]> ref-names: ["HEAD"];
    in-out property <string> active-ref: "HEAD";
    in property <string> active-filter-text: "";
    in property <string> indexing-status-text: "Ready";
    in property <bool> is-indexing: false;
    in property <bool> has-error: false;
    in property <string> worktree-label: "";

    callback open-repo-dialog();
    callback select-ref(string);
    callback clear-filter();

    height: 48px;
    background: Theme.bg-surface;
    border-width: 1px;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            Rectangle {
                width: 96px;
                height: 28px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: Theme.accent-primary;

                Text {
                    text: "git-oxide";
                    color: Theme.accent-primary;
                    font-family: Theme.font-mono;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.repo-name;
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 700;
                }

                Text {
                    text: root.repo-path;
                    color: Theme.text-secondary;
                    font-family: Theme.font-mono;
                    font-size: 11px;
                    overflow: elide;
                    max-width: 340px;
                }
            }

            if root.worktree-label != "": Rectangle {
                height: 20px;
                width: min(worktree-text.preferred-width + 14px, 280px);
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: Theme.accent-primary;
                accessible-role: text;
                accessible-label: root.worktree-label;

                worktree-text := Text {
                    width: parent.width - 14px;
                    text: root.worktree-label;
                    color: Theme.accent-primary;
                    font-family: Theme.font-mono;
                    font-size: 10px;
                    overflow: elide;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 98px;
                height: 28px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: open-touch.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                border-width: 1px;
                border-color: Theme.border-subtle;
                accessible-role: button;
                accessible-label: "Open repository directory";

                Text {
                    text: "Open Repo...";
                    color: Theme.text-primary;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                open-touch := TouchArea {
                    clicked => {
                        root.open-repo-dialog();
                    }
                }
            }

            ComboBox {
                width: 190px;
                height: 30px;
                y: (parent.height - self.height) / 2;
                model: root.ref-names;
                current-value <=> root.active-ref;
                selected(val) => {
                    root.select-ref(val);
                }
            }

            if root.active-filter-text != "" : Rectangle {
                height: 26px;
                width: filter-layout.preferred-width + 16px;
                y: (parent.height - self.height) / 2;
                border-radius: 13px;
                background: Theme.bg-selected;
                border-width: 1px;
                border-color: Theme.accent-primary;
                accessible-role: button;
                accessible-label: "Clear active commit filter";

                filter-layout := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: root.active-filter-text + "  [x]";
                        color: Theme.text-primary;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => {
                        root.clear-filter();
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            status-pill := Rectangle {
                property <color> status-color: root.has-error
                    ? Theme.accent-coral
                    : (root.is-indexing ? Theme.accent-amber : Theme.accent-emerald);

                height: 26px;
                width: min(status-label.preferred-width + 20px, 520px);
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: status-touch.has-hover && root.has-error ? Theme.bg-hover : Theme.bg-elevated;
                border-width: 1px;
                border-color: self.status-color;
                accessible-role: button;
                accessible-label: root.has-error ? "Show full error details" : root.indexing-status-text;
                accessible-action-default => {
                    if root.has-error {
                        error-popup.show();
                    }
                }

                status-label := Text {
                    width: parent.width - 20px;
                    text: root.indexing-status-text;
                    color: status-pill.status-color;
                    font-family: Theme.font-mono;
                    font-size: 11px;
                    overflow: elide;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                status-touch := TouchArea {
                    mouse-cursor: root.has-error ? MouseCursor.pointer : MouseCursor.default;
                    clicked => {
                        if root.has-error {
                            error-popup.show();
                        }
                    }
                }

                error-popup := PopupWindow {
                    x: parent.width - self.width;
                    y: parent.height + 6px;
                    width: 560px;
                    close-policy: close-on-click-outside;

                    Rectangle {
                        background: Theme.bg-elevated;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.accent-coral;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: "Error details (select to copy)";
                                color: Theme.text-secondary;
                                font-size: 11px;
                                font-weight: 700;
                            }

                            TextInput {
                                text: root.indexing-status-text;
                                read-only: true;
                                single-line: false;
                                wrap: word-wrap;
                                color: Theme.text-primary;
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                accessible-role: text-input;
                                accessible-label: "Full error message";
                            }
                        }
                    }
                }
            }
        }
    }
}
