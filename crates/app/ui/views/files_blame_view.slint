import { LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { UiTreeEntryRow, UiBlameRow } from "../models.slint";

export component FilesBlameView inherits Rectangle {
    in property <[UiTreeEntryRow]> tree-entries: [];
    in property <string> selected-tree-file: "";
    in property <[UiBlameRow]> blame-rows: [];
    in property <bool> show-blame-gutter: true;
    in-out property <string> file-filter-query: "";

    callback filter-tree-files(string);
    callback select-tree-file(string);
    callback toggle-blame-mode(bool);
    callback jump-to-commit(string);

    background: Theme.bg-canvas;

    HorizontalLayout {
        spacing: 1px;

        // Left Pane: Repository File Browser at Ref Target
        Rectangle {
            width: 320px;
            background: Theme.bg-surface;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                LineEdit {
                    placeholder-text: "Filter repository files...";
                    text <=> root.file-filter-query;
                    edited(val) => {
                        root.filter-tree-files(val);
                    }
                }

                ListView {
                    for entry in root.tree-entries : Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: entry.path == root.selected-tree-file ? Theme.bg-selected :
                                    (entry-touch.has-hover ? Theme.bg-hover : transparent);
                        accessible-role: button;
                        accessible-label: entry.path;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            alignment: space-between;

                            Text {
                                text: entry.path;
                                color: Theme.text-primary;
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            Text {
                                text: entry.language;
                                color: Theme.text-muted;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }

                        entry-touch := TouchArea {
                            clicked => {
                                root.select-tree-file(entry.path);
                            }
                        }
                    }
                }
            }
        }

        // Right Pane: AST-Highlighted File Source & Git Blame Inspector
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;

            Rectangle {
                height: 36px;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;

                    Text {
                        text: root.selected-tree-file != "" ? root.selected-tree-file : "Select a repository file";
                        color: Theme.text-primary;
                        font-family: Theme.font-mono;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            width: 88px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: root.show-blame-gutter ? Theme.bg-selected : Theme.bg-surface;
                            border-width: 1px;
                            border-color: root.show-blame-gutter ? Theme.accent-primary : Theme.border-subtle;
                            accessible-role: button;
                            accessible-label: "Git blame mode";

                            Text {
                                text: "Git Blame";
                                color: Theme.text-primary;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    root.toggle-blame-mode(true);
                                }
                            }
                        }

                        Rectangle {
                            width: 88px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: !root.show-blame-gutter ? Theme.bg-selected : Theme.bg-surface;
                            border-width: 1px;
                            border-color: !root.show-blame-gutter ? Theme.accent-primary : Theme.border-subtle;
                            accessible-role: button;
                            accessible-label: "Source code mode";

                            Text {
                                text: "Source Only";
                                color: Theme.text-primary;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    root.toggle-blame-mode(false);
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-canvas;

                ListView {
                    for row in root.blame-rows : Rectangle {
                        height: 21px;
                        background: row.is-hunk-start && root.show-blame-gutter ? #111720 : transparent;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            if root.show-blame-gutter : Rectangle {
                                width: 250px;
                                background: blame-touch.has-hover ? Theme.bg-hover : Theme.bg-surface;
                                accessible-role: button;
                                accessible-label: "Jump to blamed commit " + row.short-oid;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    alignment: space-between;

                                    Text {
                                        width: 58px;
                                        text: row.is-hunk-start ? row.short-oid : "  ⋮";
                                        color: row.is-hunk-start ? Theme.accent-primary : Theme.text-muted;
                                        font-family: Theme.font-mono;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: row.is-hunk-start ? row.author-name : "";
                                        color: Theme.text-secondary;
                                        font-size: 11px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        width: 74px;
                                        text: row.is-hunk-start ? row.date-iso : "";
                                        color: Theme.text-muted;
                                        font-family: Theme.font-mono;
                                        font-size: 10px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }

                                blame-touch := TouchArea {
                                    clicked => {
                                        if row.commit-oid-hex != "" {
                                            root.jump-to-commit(row.commit-oid-hex);
                                        }
                                    }
                                }
                            }

                            Text {
                                width: 46px;
                                text: row.line-no;
                                color: Theme.text-muted;
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }

                            HorizontalLayout {
                                spacing: 0px;
                                alignment: start;
                                for span in row.spans : Text {
                                    text: span.text;
                                    color: span.color;
                                    font-family: Theme.font-mono;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
