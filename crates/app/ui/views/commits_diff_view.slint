import { LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { UiCommitRow, UiChangedFileRow, UiDiffRow } from "../models.slint";

export component CommitsDiffView inherits Rectangle {
    in property <[UiCommitRow]> commits: [];
    in property <string> selected-commit-oid: "";
    in property <string> selected-commit-summary: "";
    in property <string> selected-commit-author: "";
    in property <string> selected-commit-date: "";
    in property <[UiChangedFileRow]> changed-files: [];
    in property <string> selected-diff-file: "";
    in property <[UiDiffRow]> diff-rows: [];
    in property <bool> is-split-diff: false;
    in-out property <string> search-query: "";

    callback filter-commits(string);
    callback select-commit(string);
    callback select-changed-file(string);
    callback toggle-diff-mode(bool);
    callback inspect-file-blame(string);

    background: Theme.bg-canvas;

    HorizontalLayout {
        spacing: 1px;

        // Left Pane: Virtualized Commit History
        Rectangle {
            width: 340px;
            background: Theme.bg-surface;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                LineEdit {
                    placeholder-text: "Search commits, authors, SHAs...";
                    text <=> root.search-query;
                    edited(val) => {
                        root.filter-commits(val);
                    }
                }

                ListView {
                    for commit in root.commits : Rectangle {
                        height: 60px;
                        border-radius: 4px;
                        background: commit.oid-hex == root.selected-commit-oid ? Theme.bg-selected :
                                    (commit-touch.has-hover ? Theme.bg-hover : transparent);
                        accessible-role: button;
                        accessible-label: commit.summary;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            HorizontalLayout {
                                alignment: space-between;
                                spacing: 6px;

                                Text {
                                    text: commit.summary;
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                            }

                            HorizontalLayout {
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 8px;

                                    Text {
                                        text: commit.short-oid;
                                        color: Theme.accent-primary;
                                        font-family: Theme.font-mono;
                                        font-size: 11px;
                                    }

                                    Text {
                                        text: commit.author-name;
                                        color: Theme.text-secondary;
                                        font-size: 11px;
                                        overflow: elide;
                                        max-width: 120px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    if commit.churn-indexed : Text {
                                        text: "+" + commit.insertions + " -" + commit.deletions;
                                        color: Theme.text-muted;
                                        font-family: Theme.font-mono;
                                        font-size: 10px;
                                    }

                                    Text {
                                        text: commit.date-iso;
                                        color: Theme.text-muted;
                                        font-family: Theme.font-mono;
                                        font-size: 10px;
                                    }
                                }
                            }
                        }

                        commit-touch := TouchArea {
                            clicked => {
                                root.select-commit(commit.oid-hex);
                            }
                        }
                    }
                }
            }
        }

        // Right Pane: Changed Files + AST-Highlighted Unified/Split Diff Viewer
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;

            // Commit Header & Changed Files Strip
            Rectangle {
                height: 128px;
                background: Theme.bg-surface;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: root.selected-commit-summary != "" ? root.selected-commit-summary : "Select a commit";
                            color: Theme.text-primary;
                            font-size: 13px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        Text {
                            text: root.selected-commit-author + "  •  " + root.selected-commit-date;
                            color: Theme.text-secondary;
                            font-size: 11px;
                        }
                    }

                    ListView {
                        for file in root.changed-files : Rectangle {
                            height: 24px;
                            border-radius: 3px;
                            background: file.path == root.selected-diff-file ? Theme.bg-selected :
                                        (file-touch.has-hover ? Theme.bg-hover : transparent);
                            accessible-role: button;
                            accessible-label: file.path;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 8px;

                                    Text {
                                        text: file.status;
                                        color: file.status == "A" ? Theme.accent-emerald :
                                               file.status == "D" ? Theme.accent-coral : Theme.accent-amber;
                                        font-family: Theme.font-mono;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: file.display-path;
                                        color: Theme.text-primary;
                                        font-family: Theme.font-mono;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    Text {
                                        text: "+" + file.insertions;
                                        color: Theme.accent-emerald;
                                        font-family: Theme.font-mono;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: "-" + file.deletions;
                                        color: Theme.accent-coral;
                                        font-family: Theme.font-mono;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            file-touch := TouchArea {
                                clicked => {
                                    root.select-changed-file(file.path);
                                }
                            }
                        }
                    }
                }
            }

            // Diff Toolbar
            Rectangle {
                height: 36px;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;

                    Text {
                        text: root.selected-diff-file;
                        color: Theme.text-primary;
                        font-family: Theme.font-mono;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            width: 74px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: !root.is-split-diff ? Theme.bg-selected : Theme.bg-surface;
                            border-width: 1px;
                            border-color: !root.is-split-diff ? Theme.accent-primary : Theme.border-subtle;
                            accessible-role: button;
                            accessible-label: "Unified diff mode";

                            Text {
                                text: "Unified";
                                color: Theme.text-primary;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    root.toggle-diff-mode(false);
                                }
                            }
                        }

                        Rectangle {
                            width: 94px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: root.is-split-diff ? Theme.bg-selected : Theme.bg-surface;
                            border-width: 1px;
                            border-color: root.is-split-diff ? Theme.accent-primary : Theme.border-subtle;
                            accessible-role: button;
                            accessible-label: "Side-by-Side diff mode";

                            Text {
                                text: "Side-by-Side";
                                color: Theme.text-primary;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    root.toggle-diff-mode(true);
                                }
                            }
                        }

                        if root.selected-diff-file != "" : Rectangle {
                            width: 96px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: Theme.bg-surface;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            accessible-role: button;
                            accessible-label: "Open file in blame view";

                            Text {
                                text: "Open Blame";
                                color: Theme.accent-primary;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    root.inspect-file-blame(root.selected-diff-file);
                                }
                            }
                        }
                    }
                }
            }

            // Virtualized Diff Lines
            Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-canvas;

                ListView {
                    for row in root.diff-rows : Rectangle {
                        height: 21px;
                        background: !root.is-split-diff ? (
                            row.kind == 1 ? Theme.diff-add-bg :
                            row.kind == 2 ? Theme.diff-del-bg :
                            row.kind == 3 ? Theme.diff-hunk-bg : transparent
                        ) : transparent;

                        if !root.is-split-diff : HorizontalLayout {
                            spacing: 0px;

                            Text {
                                width: 46px;
                                text: row.old-line;
                                color: Theme.text-muted;
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }

                            Text {
                                width: 46px;
                                text: row.new-line;
                                color: Theme.text-muted;
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }

                            Text {
                                width: 22px;
                                text: row.kind == 1 ? "+" : (row.kind == 2 ? "-" : " ");
                                color: row.kind == 1 ? Theme.accent-emerald :
                                       row.kind == 2 ? Theme.accent-coral : Theme.text-muted;
                                font-family: Theme.font-mono;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            HorizontalLayout {
                                spacing: 0px;
                                alignment: start;
                                for span in row.unified-spans : Text {
                                    text: span.text;
                                    color: span.color;
                                    font-family: Theme.font-mono;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.is-split-diff : HorizontalLayout {
                            spacing: 2px;

                            // Left (Old) Side
                            Rectangle {
                                horizontal-stretch: 1;
                                background: row.left-kind == 2 ? Theme.diff-del-bg :
                                            row.left-kind == 3 ? Theme.diff-hunk-bg :
                                            row.left-kind == 4 ? Theme.diff-empty-bg : transparent;
                                clip: true;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    Text {
                                        width: 44px;
                                        text: row.left-line;
                                        color: Theme.text-muted;
                                        font-family: Theme.font-mono;
                                        font-size: 11px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }

                                    HorizontalLayout {
                                        spacing: 0px;
                                        alignment: start;
                                        for span in row.left-spans : Text {
                                            text: span.text;
                                            color: span.color;
                                            font-family: Theme.font-mono;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Right (New) Side
                            Rectangle {
                                horizontal-stretch: 1;
                                background: row.right-kind == 1 ? Theme.diff-add-bg :
                                            row.right-kind == 3 ? Theme.diff-hunk-bg :
                                            row.right-kind == 4 ? Theme.diff-empty-bg : transparent;
                                clip: true;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    Text {
                                        width: 44px;
                                        text: row.right-line;
                                        color: Theme.text-muted;
                                        font-family: Theme.font-mono;
                                        font-size: 11px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }

                                    HorizontalLayout {
                                        spacing: 0px;
                                        alignment: start;
                                        for span in row.right-spans : Text {
                                            text: span.text;
                                            color: span.color;
                                            font-family: Theme.font-mono;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
